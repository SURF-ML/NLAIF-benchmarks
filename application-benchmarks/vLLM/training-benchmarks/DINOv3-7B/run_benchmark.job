#!/bin/bash
#SBATCH -J dinov3_vit7b16_pretrain
#SBATCH -p gpu_h100
#SBATCH -N 8
#SBATCH --ntasks-per-node=4
#SBATCH --gpus-per-node=4
#SBATCH --cpus-per-task=16
#SBATCH -t 48:00:00
#SBATCH -o logs/benchmark_%j.out
#SBATCH -e logs/benchmark_%j.err

set -euo pipefail


export DINOV3_DIR="${SLURM_SUBMIT_DIR}"
source ${DINOV3_DIR}/dino_venv/bin/activate

cd ${DINOV3_DIR}
mkdir -p logs

# Dataset paths
export ROOT_PATH="${ROOT_PATH:-/scratch-nvme/ml-datasets/imagenet/torchvision_ImageFolder}"
export EXTRA_PATH="${EXTRA_PATH:-/home/larsve/MLPerfTraining/data/imagenet1k/extra}"
echo "Dataset root: ${ROOT_PATH}"
echo "Dataset extra: ${EXTRA_PATH}"

# Optional: Prepare dataset (disabled by default)
PREP_DATASET="${PREP_DATASET:-0}"
if [ "${PREP_DATASET}" = "1" ]; then
    echo "Preparing ImageNet dataset..."
    python imagenet1k_prep.py --root "${ROOT_PATH}" --extra "${EXTRA_PATH}"
    echo "Dataset preparation complete"
fi

export OUTPUT_DIR="${OUTPUT_DIR:-/scratch-shared/${USER}/dinov3_vit7b16_pretrain_${SLURM_JOB_ID}}"
echo "Output directory: ${OUTPUT_DIR}"


# OMP threads = cpus-per-task; one thread per core
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
export PYTHONPATH=${PWD}/dinov3_src:${PWD}/dinov3_src:${PWD}
export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-eno2np0}"
export GLOO_SOCKET_IFNAME="${GLOO_SOCKET_IFNAME:-eno2np0}"
# export NCCL_DEBUG=INFO

export CONFIG_FILE="${DINOV3_DIR}/configs/train/benchmark.yaml"
echo "Config file: ${CONFIG_FILE}"
cat "${CONFIG_FILE}"

export SEED=${SEED:-2}
echo "Seed: ${SEED}"

export DATA_ARGS="train.dataset_path=ImageNet:split=TRAIN:root=${ROOT_PATH}:extra=${EXTRA_PATH}"
echo "Data args: ${DATA_ARGS}"

# Export variables for record_time_and_run.sh
export SLURM_NTASKS_PER_NODE

# Use record_time_and_run.sh to track timing
"${DINOV3_DIR}/record_time_and_run.sh"

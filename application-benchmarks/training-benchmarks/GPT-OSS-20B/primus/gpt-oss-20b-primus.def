Bootstrap: docker
From: nvcr.io/nvidia/pytorch:25.12-py3

%files
    patches/primus_evaluator.patch /workspace/code/patches/primus_evaluator.patch
    patches/megatron_validation_consumed_samples.patch /workspace/code/patches/megatron_validation_consumed_samples.patch
    primus_mllog-0.1.0-py3-none-any.whl /workspace/code/primus_mllog-0.1.0-py3-none-any.whl
    mlperf_logger.py /workspace/code/mlperf_logger.py
    . /workspace/code

%post
    # Set working directory
    cd /workspace

    # Install initial Python packages
    pip install --no-cache-dir \
        pyyaml \
        pybind11 \
        ninja \
        packaging \
        transformers

    # Clone and setup Primus
    mkdir -p /workspace/deps
    cd /workspace/deps
    git clone --recursive https://github.com/AMD-AIG-AIMA/Primus.git
    cd Primus
    git checkout tags/v0.7.0
    git submodule update --init --recursive
    pip install -r requirements.txt
    git apply /workspace/code/patches/primus_evaluator.patch

    # Setup Megatron-LM
    cd /workspace/deps/Primus/third_party/Megatron-LM
    git apply /workspace/code/patches/megatron_validation_consumed_samples.patch
    pip install -e . --no-deps

    # Install primus-mllog from local wheel, then apply PP-aware logging fix
    cd /workspace/code
    pip install primus_mllog-0.1.0-py3-none-any.whl
    cp /workspace/code/mlperf_logger.py \
        /usr/local/lib/python3.12/dist-packages/primus_mllog/mlperf_logger.py

    # Install additional packages
    pip install --no-build-isolation git+https://github.com/fanshiqing/grouped_gemm@v1.1.4
    pip install --no-build-isolation git+https://github.com/NVIDIA/mlperf-common.git@b86d175a05849d650a8ff69c1e2c37b9f4e61d51

%environment
    export PYTHONPATH="/workspace/deps/Primus:/workspace/deps/Primus/third_party/Megatron-LM"

%runscript
    cd /workspace/code
    exec "$@"
